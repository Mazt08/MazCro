# Virtual environments
.venv/
venv/
env/

# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class
*.so

# Packaging / build
build/
*.egg-info/
.eggs/

# PyInstaller spec (auto-generated)
macro_script.spec

# dist — allow the exe, ignore everything else
dist/*
!dist/macro_script.exe

# Test / coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# Editors
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Exported macros
*.json
!example.json
