# Exclude .gitignore from version control
!.gitignore

# Virtual environments
.venv/
venv/
env/

# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class
*.so

# Packaging / build
build/
dist/
*.egg-info/
.eggs/
*.spec.bak

# Test / coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# Editors
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Exported macros
*.json
!example.json

